{
  "$comment": "Extracted verbatim from reference/prototype.html. Every value is as tuned in the prototype; nothing is rounded, rationalised, or re-scaled. Where the prototype hard-codes a value inline (canvas fills, shadow recipes) it is recorded here under the region that owns it. src/ui styles consume this file and nothing else.",
  "meta": {
    "source": "reference/prototype.html",
    "device": { "width": 390, "height": 844, "$comment": "The design viewport. All cqh-relative type is sized against this." },
    "breakpoint": { "mobile": "780px", "$comment": "max-width at which the stage stacks and the app fills the screen" },
    "containerQuery": { "on": ".app", "type": "size", "$comment": "the readout numeral sizes in cqh against the app container, not the viewport" }
  },

  "color": {
    "page": {
      "$comment": "Page chrome around the device. Light by default, dark via prefers-color-scheme or [data-theme]. Never used inside the app.",
      "light": {
        "ground": "#E4EAEE",
        "ink": "#0B1A24",
        "muted": "#4A5E6B",
        "line": "rgba(11,26,36,.16)",
        "accent": "#3E6652"
      },
      "dark": {
        "ground": "#060E14",
        "ink": "#DCE7EE",
        "muted": "#8196A4",
        "line": "rgba(220,231,238,.14)",
        "accent": "#7FA38F"
      }
    },

    "app": {
      "$comment": "The instrument is always dark, like the room it lives in. No light variant.",
      "ground": "#0A1822",
      "raise": "#112836",
      "frost": "#E3ECF1",
      "steel": "#8FA4B2",
      "rule": "rgba(227,236,241,.13)",
      "frost82": "rgba(227,236,241,.82)",
      "frost86": "rgba(227,236,241,.86)",
      "frost85": "rgba(227,236,241,.85)",
      "frost80": "rgba(227,236,241,.8)",
      "frost55": "rgba(227,236,241,.55)"
    },

    "state": {
      "$comment": "One colour per alert state. Bound to --sc on .app and inherited by the state word, glyph, rate, spark line, hysteresis ticks, feed dot and rack outline. Offline is a rack condition, not a fifth state: it reuses steel.",
      "calm": "#74CFEA",
      "recovering": "#9ED9C4",
      "rising": "#FFB547",
      "critical": "#C96764",
      "offline": "#8FA4B2",
      "criticalInk": "#1A0605",
      "criticalOnRaised": "#D4736F",
      "$reserved": "Red is signal only: temperature, state word/glyph, rack outline, rate, and the single primary action. Never a container, panel, or border colour.",
      "$criticalOnRaised": "Critical TEXT on a raised surface (--c-raise) uses criticalOnRaised (~4.7:1 on raise) instead of critical (~4.1:1 on raise) to hold AA. critical stays the red on the app ground and everywhere else; this is the one raised-surface exception, currently the queue card's state word and temperature."
    },

    "action": {
      "$comment": "Hold-to-confirm slab button. Warn fill below critical, deep red at critical.",
      "holdBg": "#FFB547",
      "holdInk": "#1E1204",
      "holdCriticalBg": "#A84A48",
      "holdCriticalInk": "#FFFFFF",
      "holdFill": "rgba(255,255,255,.35)",
      "holdFillCritical": "rgba(255,255,255,.2)"
    },

    "field": {
      "$comment": "Thermal map. A heat-map ramp, deliberately separate from the alert palette.",
      "background": "#10263A",
      "lut": [
        [0, "#132C3E"],
        [0.3, "#1C4A62"],
        [0.5, "#3A5566"],
        [0.64, "#6B2E2A"],
        [0.78, "#C94A26"],
        [0.9, "#E88A45"],
        [1, "#F6DDC0"]
      ],
      "rackFill": "rgba(30,52,68,.92)",
      "rackStrokeCalm": "rgba(227,236,241,.3)",
      "rackLabelCalm": "rgba(227,236,241,.72)",
      "rackDownFill": "rgba(2,5,8,.97)",
      "rackDownStroke": "#8FA4B2",
      "chipBg": "rgba(10,24,34,.9)",
      "chipStrokeCalm": "rgba(227,236,241,.2)",
      "chipInk": "#E3ECF1",
      "cracFill": "rgba(30,52,68,.94)",
      "cracStrokeIdle": "rgba(227,236,241,.34)",
      "cracStrokeBoosted": "#74CFEA",
      "cracInkIdle": "rgba(227,236,241,.8)",
      "cracInkBoosted": "#74CFEA",
      "streamNear": "rgba(150,222,245,ALPHA)",
      "streamMid": "rgba(116,207,234,ALPHA)",
      "streamFar": "rgba(116,207,234,0)",
      "streamAlphaIdle": 0.22,
      "streamAlphaBoosted": 0.75,
      "streamMidAlphaFactor": 0.45
    },

    "surface": {
      "device": "#1A2229",
      "outcome": "#0F2432",
      "outcomeInk": "rgba(227,236,241,.86)",
      "outcomePrimaryOkBg": "#74CFEA",
      "outcomePrimaryOkInk": "#06202B",
      "outcomePrimaryFailBg": "#A84A48",
      "outcomePrimaryFailInk": "#FFFFFF",
      "outcomePrimaryMixedBg": "#FFB547",
      "outcomePrimaryMixedInk": "#1E1204",
      "event": "rgba(10,24,34,.94)",
      "introScrim": "linear-gradient(to top, rgba(6,14,20,.96) 45%, rgba(6,14,20,.55))",
      "introStartBg": "#E3ECF1",
      "introStartInk": "#0A1822",
      "lockScrim": "rgba(4,10,14,.4)",
      "notif": "rgba(30,44,54,.8)",
      "notifCritical": "rgba(44,24,20,.85)",
      "numOffline": "#5D7282",
      "demoPillBg": "rgba(10,24,34,.7)",
      "demoPillBorder": "rgba(227,236,241,.18)"
    },

    "demo": {
      "$comment": "Panel controls are desaturated dark green. Never blue: blue reads as cold air.",
      "accentLight": "#3E6652",
      "accentDark": "#7FA38F",
      "heatSlider": "#950606"
    }
  },

  "type": {
    "family": "'Archivo','Arial Narrow',system-ui,-apple-system,sans-serif",
    "variableAxes": { "wdth": [62, 125], "wght": [100, 900] },
    "$comment": "One family. The wdth axis carries escalation: the readout numeral widens and thickens as the state climbs. That is information, not decoration.",

    "bar": {
      "site": { "size": "15px", "wdth": 100, "wght": 700 },
      "aisle": { "size": "13px", "wdth": 100, "wght": 450 },
      "feed": { "size": "13px" }
    },
    "queue": {
      "id": { "size": "15px", "wdth": 100, "wght": 720 },
      "word": { "size": "13.5px", "wdth": 100, "wght": 620 },
      "urgentChip": { "size": "11.5px", "wdth": 100, "wght": 700 },
      "cause": { "size": "12.5px" },
      "temp": { "size": "16px", "wdth": 90, "wght": 700, "numeric": "tabular-nums" }
    },
    "readout": {
      "state": { "size": "13px", "wdth": 100, "wght": 650 },
      "hysteresis": { "size": "12px", "wdth": 100, "wght": 500 },
      "numeral": {
        "$comment": "Per state. Size is min(px, cqh) so it holds shape when the app is not 844 tall. letterSpacing is constant.",
        "letterSpacing": "-.01em",
        "calm": { "size": "min(64px,7.7cqh)", "wdth": 68, "wght": 380 },
        "recovering": { "size": "min(70px,8.4cqh)", "wdth": 74, "wght": 480 },
        "rising": { "size": "min(76px,9.1cqh)", "wdth": 84, "wght": 620 },
        "critical": { "size": "min(73px,8.5cqh)", "wdth": 104, "wght": 820 },
        "offline": { "size": "min(77px,9.1cqh)", "wdth": 104, "wght": 820, "minSize": "24px", "$comment": "Deliberately dimmed (color.surface.numOffline, ~3.6:1): the reading is stale once a rack is offline, and state is carried at full contrast by the word and glyph, not the numeral. Passes AA only as large text, so this numeral must never render below minSize." },
        "multiRack": { "size": "min(60px,7.1cqh)", "$comment": "overrides size only when a second rack is queued; wdth/wght still come from state" }
      },
      "unit": { "size": ".26em", "wdth": 100, "wght": 500 },
      "meta": { "size": "12px" },
      "rate": { "wdth": 100, "wght": 620, "numeric": "tabular-nums" },
      "projection": { "size": "12px", "lineHeight": 1.3 },
      "projectionEmphasis": { "wdth": 100, "wght": 620 }
    },
    "action": {
      "calmMessage": { "size": "12.5px", "lineHeight": 1.4 },
      "why": { "size": "12px", "lineHeight": 1.45, "wdth": 100, "wght": 450, "maxWidth": "38ch" },
      "whyCritical": { "wdth": 100, "wght": 560 },
      "status": { "size": "12px", "lineHeight": 1.45, "wdth": 100, "wght": 620 },
      "hold": { "size": "13.5px", "wdth": 100, "wght": 720 },
      "ghost": { "size": "12px", "wdth": 100, "wght": 600 }
    },
    "outcome": {
      "title": { "size": "21px", "lineHeight": 1.05, "wdth": 78, "wght": 760 },
      "body": { "size": "13.5px", "lineHeight": 1.45 },
      "statLabel": { "size": "11.5px" },
      "statValue": { "size": "18px", "wdth": 80, "wght": 720, "numeric": "tabular-nums" },
      "primary": { "size": "15.5px", "wdth": 100, "wght": 720 }
    },
    "intro": {
      "kicker": { "size": "13px", "numeric": "tabular-nums" },
      "title": { "size": "32px", "lineHeight": 1.02, "wdth": 74, "wght": 740 },
      "body": { "size": "14.5px", "lineHeight": 1.5, "maxWidth": "32ch" },
      "start": { "size": "15.5px", "wdth": 100, "wght": 720 },
      "look": { "size": "13.5px" }
    },
    "lock": {
      "date": { "size": "17px", "wdth": 100, "wght": 500 },
      "time": { "size": "92px", "lineHeight": 1, "wdth": 70, "wght": 300, "numeric": "tabular-nums" },
      "notifApp": { "size": "12.5px", "wdth": 100, "wght": 600 },
      "notifWhen": { "size": "12.5px" },
      "notifTitle": { "size": "15.5px", "wdth": 100, "wght": 680 },
      "notifBody": { "size": "14.5px", "lineHeight": 1.35 },
      "hint": { "size": "13px" }
    },
    "event": { "size": "13px", "wdth": 100, "wght": 640 },
    "fieldCanvas": {
      "$comment": "Canvas text is set imperatively; recorded here so it stays in step with the DOM scale.",
      "rackLabel": { "size": "clamp(9px, 2 * cellHeight, 11.5px)", "wghtCalm": 500, "wghtAlert": 650 },
      "chip": { "size": "12px", "wght": 650 },
      "crac": { "size": "11px", "wghtIdle": 500, "wghtBoosted": 650 }
    },
    "demo": {
      "h1": { "size": "36px", "lineHeight": 1.02, "letterSpacing": "-.01em", "wdth": 72, "wght": 720 },
      "h2": { "size": "18px", "wdth": 90, "wght": 700 },
      "body": { "size": "15.5px", "lineHeight": 1.5 },
      "label": { "size": "14.5px", "wdth": 100, "wght": 600 },
      "button": { "size": "14.5px", "wdth": 100, "wght": 620 },
      "steps": { "size": "14.5px", "lineHeight": 1.5 },
      "log": { "size": "13.5px", "lineHeight": 1.35 },
      "logEmphasis": { "wdth": 100, "wght": 640 },
      "pill": { "size": "12px", "wdth": 100, "wght": 600 },
      "backLink": { "size": "14px" }
    }
  },

  "radius": {
    "device": "54px",
    "app": "44px",
    "field": "24px",
    "queueCard": "16px",
    "urgentChip": "6px",
    "slab": "20px",
    "hold": "12px",
    "outcome": "28px",
    "outcomePrimary": "14px",
    "notif": "22px",
    "introStart": "14px",
    "pill": "999px",
    "demoButton": "12px",
    "tick": "2px",
    "canvasRack": "min(5px, rackHeight / 3)",
    "canvasCrac": "7px",
    "canvasChip": "11px"
  },

  "space": {
    "stage": { "gap": "72px", "padding": "40px 24px" },
    "device": { "padding": "10px" },
    "bar": { "height": "60px", "padding": "0 24px 10px", "aisleGap": "8px", "feedGap": "8px", "dot": "8px" },
    "queue": { "padding": "0 14px", "cardGap": "11px", "cardMarginTop": "8px", "cardPadding": "10px 14px", "metaGap": "2px", "headGap": "8px", "chipPadding": "2px 7px" },
    "field": { "margin": "0 10px" },
    "event": { "top": "10px", "padding": "7px 13px", "gap": "8px", "dot": "7px" },
    "readout": { "gap": "6px", "padding": "10px 22px 8px", "multiPaddingTop": "8px", "stateGap": "10px", "glyph": "14px", "hysteresisGap": "5px", "tickWidth": "14px", "tickHeight": "4px", "unitMargin": ".16em 0 0 .14em", "metaGap": "12px", "sparkHeight": "31px", "sparkViewBox": "0 0 300 44" },
    "action": { "padding": "0 12px 12px", "slabGap": "10px", "slabPadding": "14px 14px 10px", "calmMessagePadding": "0 4px 2px", "statusCheckGap": "7px", "holdHeight": "44px", "rowGap": "12px", "ghostPadding": "2px 2px 4px", "underlineOffset": "3px" },
    "outcome": { "inset": "12px", "padding": "20px 20px 16px", "headGap": "11px", "glyph": "20px", "bodyMargin": "12px 0 18px", "statsGap": "12px", "statsMargin": "0 0 20px", "statsPadding": "16px 0 0", "statValueMarginTop": "4px", "buttonsGap": "14px", "primaryHeight": "48px" },
    "intro": { "padding": "28px 24px 30px", "titleMargin": "8px 0 10px", "bodyMargin": "0 0 24px", "startHeight": "50px", "lookMarginTop": "14px", "lookPadding": "4px" },
    "lock": { "padding": "92px 14px 40px", "timeMarginTop": "4px", "notifMarginTop": "44px", "notifGap": "3px 8px", "notifPadding": "14px 16px 15px" },
    "demo": { "panelMaxWidth": "340px", "h1Margin": "0 0 14px", "pMargin": "0 0 14px", "ctrlMargin": "24px 0 8px", "ctrlLabelMarginBottom": "8px", "buttonsGap": "10px", "buttonsMargin": "14px 0", "buttonPadding": "11px 16px", "checkGap": "10px", "checkBox": "18px", "stepsMargin": "0 0 20px", "stepsPaddingLeft": "20px", "stepMarginBottom": "6px", "stepPaddingLeft": "4px", "h2Margin": "32px 0 10px", "logMaxHeight": "230px", "logColumns": "70px 1fr", "logGap": "8px", "logRowPadding": "8px 0", "mobilePanelPadding": "32px 22px 56px", "mobilePillTop": "calc(env(safe-area-inset-top, 0px) + 8px)", "mobilePillPadding": "5px 12px", "mobileBackLinkMargin": "0 0 18px", "mobileDeviceMinHeight": "640px" }
  },

  "layout": {
    "$comment": "The escalation is a shape change, not a style change. These fr weights are the four rows of .body (field, queue, readout, action) and are what composeScreen(simState) returns. Offline uses the critical shape.",
    "rows": ["field", "queue", "readout", "action"],
    "weights": {
      "calm":       { "field": "1.25fr", "queue": "0fr", "readout": ".8fr",  "action": ".36fr" },
      "recovering": { "field": "1.5fr",  "queue": "0fr", "readout": ".85fr", "action": ".6fr" },
      "rising":     { "field": "1.7fr",  "queue": "0fr", "readout": ".9fr",  "action": ".72fr" },
      "critical":   { "field": "1.8fr",  "queue": "0fr", "readout": ".95fr", "action": ".72fr" },
      "offline":    { "field": "1.8fr",  "queue": "0fr", "readout": ".95fr", "action": ".72fr" }
    },
    "multiRackOverride": {
      "$comment": "Applied on top of the state weights when a second rack is queued. It overrides field, queue and readout; action keeps its state value.",
      "field": "1.5fr", "queue": ".36fr", "readout": ".95fr"
    },
    "zIndex": { "event": 2, "shock": 3, "outcome": 4, "lock": 6, "intro": 7, "demoPill": 20 }
  },

  "field": {
    "$comment": "Thermal field geometry, in grid cells. Locked because the rack layout, plume shape and streamline seeds are all expressed in these units.",
    "grid": { "width": 28, "height": 48 },
    "rack": { "count": 16, "sides": 2, "perSide": 8, "xLeft": 1, "xRight": 21, "w": 6, "yStart": 1.5, "yStep": 5.1, "h": 4.4 },
    "crac": { "x": 8, "w": 12, "y": 43.6, "h": 3.4, "minPixelHeight": 16 },
    "aisle": { "left": 7.3, "right": 20.7, "center": 14 },
    "diffusion": 0.23,
    "supplyBleed": 0.0035,
    "streamlines": { "idle": 8, "boosted": 16, "traceSteps": 400, "seedSpread": 3.2, "seedExponent": 1.6 },
    "devicePixelRatioCap": 2
  },

  "motion": {
    "$comment": "Every duration and curve as tuned. Nothing here is decorative: each entry is attached to a piece of information changing. Under reduced motion all of it is replaced by the crossfade below.",
    "easing": {
      "restructure": "cubic-bezier(.65,0,.35,1)",
      "settle": "cubic-bezier(.3,1.3,.5,1)",
      "settleSoft": "cubic-bezier(.3,1.2,.5,1)",
      "settleSwap": "cubic-bezier(.3,1.1,.4,1)",
      "settleEvent": "cubic-bezier(.3,1.35,.5,1)",
      "settleField": "cubic-bezier(.3,1.25,.4,1)",
      "digit": "cubic-bezier(.3,.7,.2,1)",
      "shock": "cubic-bezier(.12,.6,.3,1)",
      "leave": "cubic-bezier(.5,0,.75,0)",
      "lock": "cubic-bezier(.3,0,.2,1)",
      "ease": "ease",
      "easeOut": "ease-out"
    },
    "restructure": { "property": "grid-template-rows", "duration": "0.75s", "easing": "restructure" },
    "numeral": { "duration": "0.65s", "easing": "restructure", "delay": "0.1s", "colorDuration": "0.5s" },
    "digitRoll": { "duration": "0.5s", "easing": "digit" },
    "stateColor": { "duration": "0.4s" },
    "hysteresisTicks": { "opacity": "0.3s", "fill": "0.3s" },
    "feedDot": { "colorDuration": "0.4s", "ring": { "duration": "0.9s", "easing": "easeOut", "fromScale": 0.6, "toScale": 2.1, "fromOpacity": 0.9 } },
    "queueCardIn": { "duration": "0.6s", "easing": "settle", "delay": "0.35s", "fromY": "-14px", "fromScale": 0.97 },
    "readoutSwap": { "duration": "0.5s", "easing": "settleSwap", "fromX": "28px" },
    "fieldTilt": { "duration": "1s", "easing": "settleField", "delay": "0.15s", "transform": "perspective(900px) rotateX(15deg)", "appliesTo": "critical" },
    "criticalVignette": { "duration": "0.9s", "easing": "ease", "delay": "0.2s", "shadow": "inset 0 0 120px rgba(201,103,100,.10)" },
    "shock": { "duration": "1.3s", "easing": "shock", "secondDelay": "0.2s", "fromSize": "16px", "toSize": "1100px", "border": "2px solid #C96764", "glow": "0 0 28px rgba(201,103,100,.55), inset 0 0 28px rgba(201,103,100,.35)" },
    "event": { "transform": "0.5s", "easing": "settleEvent", "opacity": "0.3s", "visibleMs": 3800 },
    "slab": { "background": "0.5s", "color": "0.4s" },
    "slabRise": { "duration": "0.8s", "easing": "settle", "delay": "0.42s", "fromY": "55%", "appliesTo": "critical" },
    "slabRiseSoft": { "duration": "0.55s", "easing": "settleSoft", "delay": "0.3s", "fromY": "22%", "appliesTo": "rising" },
    "statusFresh": { "duration": "1.4s", "easing": "easeOut", "fromY": "8px", "settleAt": 0.25 },
    "outcomeIn": { "duration": "0.85s", "easing": "settle", "delay": "0.2s", "fromY": "55%" },
    "outcomeOut": { "transform": "0.55s", "easing": "leave", "opacity": "0.4s", "opacityDelay": "0.15s", "toY": "110%", "removeAfterMs": 600 },
    "introOut": { "duration": "0.45s", "easing": "ease", "hiddenAfterMs": 460 },
    "lockOpen": { "duration": "0.5s", "easing": "lock", "toScale": 1.08, "hiddenAfterMs": 480 },
    "notifIn": { "transform": "0.6s", "easing": "settleEvent", "opacity": "0.35s", "fromY": "-40px", "fromScale": 0.96 },
    "failDesaturate": { "duration": "1.2s", "filter": "saturate(.55) brightness(.85)" },
    "demoPill": { "opacity": "0.25s" },
    "reduced": {
      "$comment": "Not a removal: a second, designed choreography. All transitions and animations are zeroed, and a state change instead crossfades the body.",
      "crossfade": { "duration": "0.35s", "easing": "easeOut", "fromOpacity": 0.3 }
    }
  },

  "timing": {
    "$comment": "Choreography timers. In the port these become sim events driven by reading count, not setTimeouts (see docs/BUILD_BRIEF.md).",
    "readIntervalMs": 1500,
    "simSecondsPerReading": 15,
    "holdMs": 750,
    "holdHintRevertMs": 2000,
    "keyboardArmWindowMs": 3000,
    "focusHandoffMs": 1600,
    "standDownMs": 2500,
    "outcomeFocusMs": 300,
    "liveRegionResetMs": 60,
    "aftershockReadings": 14,
    "fieldFrameThrottleMs": 33,
    "fieldStepsPerFrame": 2,
    "fieldResetSteps": 400,
    "reducedMotionStepsPerReading": 40,
    "haptics": { "escalateToCritical": [70, 50, 70], "shutdown": [200, 80, 200], "confirmAction": 30 }
  },

  "focus": {
    "$comment": "Focus rings are a fixed 3px. Ring colour differs by ground so it always clears AA against what is behind it.",
    "width": "3px",
    "app": { "color": "#E3ECF1", "offset": "3px" },
    "queueCard": { "color": "#E3ECF1", "offset": "2px" },
    "intro": { "color": "#74CFEA", "offset": "3px" },
    "demo": { "color": "var(--accent)", "offset": "2px" }
  },

  "shadow": {
    "device": "inset 0 1px 0 rgba(255,255,255,.09), 0 0 0 1px rgba(0,0,0,.35), 0 50px 90px -40px rgba(0,0,0,.6)",
    "outcome": "0 -10px 36px -12px rgba(0,0,0,.4), inset 0 0 0 1px rgba(227,236,241,.13)",
    "focusedRackGlow": { "blur": 14, "color": "state colour of the focused rack" }
  },

  "blur": {
    "intro": "blur(6px)",
    "lock": "blur(22px) brightness(.5) saturate(.8)",
    "demoPill": "blur(10px)"
  },

